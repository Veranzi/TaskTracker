# Postgres connection (use Supabase's Transaction pooler URL for serverless/Vercel).
# Dashboard → Project Settings → Database → Connection string → Transaction pooler.
# Remember to URL-encode special chars in your password (`?` → `%3F`, `@` → `%40`, etc).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project URL & publishable key (browser-safe).
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
